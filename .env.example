# Optional settings, read by Docker Compose when this file is named .env (ignored by Git).
# Dashboard port on this computer (default 8080).
# CAJUI_PORT=8080
# Broker port and interface (default 1883 on all interfaces, for devices on the network).
# CAJUI_MQTT_PORT=1883
# CAJUI_MQTT_BIND=127.0.0.1
# Image tag (default main).
# CAJUI_VERSION=main
